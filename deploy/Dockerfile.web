# Zero-install Flutter Web UI image (served via nginx, proxying /api/ to the API container).
FROM ghcr.io/cirruslabs/flutter:3.50.0 AS build
WORKDIR /src
COPY app app
RUN cd app && flutter pub get && flutter build web --release --no-web-resources-cdn

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/app/build/web /usr/share/nginx/html
EXPOSE 80
