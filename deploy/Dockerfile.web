# Flutter Web UI served by nginx, with the API on the same origin.
FROM debian:trixie-slim AS build
ARG FLUTTER_VERSION=3.50.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "$FLUTTER_VERSION" https://github.com/flutter/flutter.git /opt/flutter
ENV PATH="/opt/flutter/bin:$PATH"
ENV CI=true
WORKDIR /src/app
COPY app/ ./
RUN flutter pub get \
    && flutter build web --release --no-web-resources-cdn --no-wasm-dry-run --dart-define=TRADOCRAFT_SAME_ORIGIN=true

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/app/build/web /usr/share/nginx/html
EXPOSE 80
